# Copy this file to `.env` for local testing (never commit the real .env)
# These same values are configured in GitHub as Secrets/Variables when deploying.

# ---- MUST HAVE (free) ----
# Google AI Studio free API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Your GitHub username (used to build the default site URL)
GITHUB_USERNAME=your-github-username

# ---- OPTIONAL (free) ----
# Guardian Open Platform dev key: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# Pexels free image search key: https://www.pexels.com/api/
PEXELS_API_KEY=

# ---- Site identity ----
SITE_NAME=Auto News Daily
SITE_TAGLINE=Fresh headlines, summarized by AI
SITE_URL=https://your-github-username.github.io/auto-news/
KO_FI_URL=
SITE_DISCLOSURE=

# ---- Behaviour ----
MAX_STORIES=12
SUMMARY_WORDS=80
GEMINI_MODEL=